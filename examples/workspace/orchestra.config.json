{
  "orchestra_version": "0.3.0",
  "project": "todo-workspace",
  "profile": "lite",
  "stack": {
    "language": "sh",
    "test": "true",
    "test_one": "for f in {files}; do sh \"$f\" || exit 1; done",
    "integration": "sh e2e.sh"
  },
  "repos": {
    "api": {
      "path": "api",
      "stack": {
        "language": "sh",
        "test": "for f in test/*.sh; do sh \"$f\" || exit 1; done",
        "test_one": "for f in {files}; do sh \"$f\" || exit 1; done"
      }
    },
    "web": {
      "path": "web",
      "stack": {
        "language": "sh",
        "test": "for f in test/*.sh; do sh \"$f\" || exit 1; done",
        "test_one": "for f in {files}; do sh \"$f\" || exit 1; done"
      }
    }
  },
  "brain": {
    "planner": "claude",
    "reviewer": "claude -p --output-format json",
    "confirmer": { "cmd": "claude -p --output-format json", "model": "claude-haiku-4-5-20251001" }
  },
  "agents": [
    { "name": "claude", "adapter": "claude", "skills": ["backend", "frontend"] }
  ],
  "escalation": {
    "confidence_threshold": 0.75,
    "always_human": ["auth"],
    "max_verify_rounds": 3,
    "max_reject_rounds": 3
  }
}
