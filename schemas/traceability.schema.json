{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestra.local/schemas/traceability.schema.json",
  "title": "traceability.json",
  "description": "Single source of truth for Requirement -> Task -> Test. Keyed by FR id. Empty task/test lists are allowed while drafting; the readiness check enforces coverage.",
  "type": "object",
  "propertyNames": { "pattern": "^FR-[0-9]+$" },
  "additionalProperties": { "$ref": "#/$defs/requirement" },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desc", "tasks", "tests", "acceptance", "status"],
      "properties": {
        "desc": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^T[0-9]+$" }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["planned", "implemented", "accepted"],
          "description": "planned -> implemented (tests green) -> accepted (merged). Updated by the engine."
        }
      }
    }
  }
}
